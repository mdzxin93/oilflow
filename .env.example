# Run npm run setup to create a real local .env with your own credentials.
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/oilflow?replicaSet=oilflow-rs&directConnection=true
DB_NAME=oilflow
MONGODB_VERSION=8.0.16
SESSION_SECRET=GENERATE_WITH_NPM_RUN_SETUP
ADMIN_EMAIL=admin@oilflow.local
ADMIN_PASSWORD=CHOOSE_AT_LEAST_10_CHARACTERS
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
COOKIE_SECURE=false
# For an existing system binary (optional): MONGODB_SYSTEM_BINARY=C:/MongoDB/bin/mongod.exe
# Production HTTPS: NODE_ENV=production, APP_ORIGIN=https://your-domain, COOKIE_SECURE=true
